{
  "name": "Generic OSC Fader Wing — 24 faders",
  "description": "Maps 24 OSC faders (range 0..1) onto MA3 executor faders 201..224 (page 1). Works with any OSC controller that can send /wing/fader/N — TouchOSC, Lemur, Companion, X-Touch via OSC bridge, custom DIY wings. Each fader is also wired to a 'flash' button at /wing/flash/N (push to bump executor to 100%). When MA3 page 1 holds your show executors (sequences, dimmers, masters), this gives you a 24-channel virtual wing instantly.",
  "mappings": [
    {
      "name": "Wing fader 1 → Exec 201",
      "enabled": true,
      "trigger": { "type": "osc", "match": "/wing/fader/1" },
      "transform": { "scale": 1.0 },
      "action": { "type": "osc", "address": "/Page1/Fader201", "argType": "f" }
    },
    {
      "name": "Wing fader 2 → Exec 202",
